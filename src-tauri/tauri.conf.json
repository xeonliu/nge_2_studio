{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NGE2 ISO Studio",
  "version": "0.1.0",
  "identifier": "io.github.xeonliu.nge2-iso-studio",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NGE2 ISO Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: nge2-preview: data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Read-only NGE2 PSP ISO inspector",
    "longDescription": "Inspect NGE2 ISO9660, HGAR, HGPT, and EVS resources without unpacking the disc image.",
    "copyright": "GPL-3.0-only"
  }
}
